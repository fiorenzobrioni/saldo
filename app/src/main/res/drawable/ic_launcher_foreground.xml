<?xml version="1.0" encoding="utf-8"?>
<!--
    Flat wallet glyph: two cards peeking out from behind a bifold wallet body.
    Multi-color by design (gold + coral cards, cream body) for a premium,
    non-generic launcher icon; placeholder until final branding.

    The whole artwork is wrapped in one group that scales it down and nudges it
    slightly up, so it keeps a comfortable margin from the maskable edge and the
    solid wallet body reads as vertically centred: a purely geometric centre
    looks low here, since the top is the two pointed cards while the bottom is a
    full rounded body. The wallet stitch line is a thick pill.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.80"
        android:scaleY="0.80"
        android:translateY="-1.0">

        <group
            android:pivotX="15"
            android:pivotY="9.5"
            android:rotation="-11"
            android:translateX="28"
            android:translateY="23.5">
            <path
                android:fillColor="#F5A623"
                android:pathData="M4,0 H26 a4,4 0 0 1 4,4 V15 a4,4 0 0 1 -4,4 H4 a4,4 0 0 1 -4,-4 V4 a4,4 0 0 1 4,-4 Z" />
        </group>

        <group
            android:pivotX="15"
            android:pivotY="9.5"
            android:rotation="11"
            android:translateX="50"
            android:translateY="23.5">
            <path
                android:fillColor="#FF6F61"
                android:pathData="M4,0 H26 a4,4 0 0 1 4,4 V15 a4,4 0 0 1 -4,4 H4 a4,4 0 0 1 -4,-4 V4 a4,4 0 0 1 4,-4 Z" />
        </group>

        <path
            android:fillColor="#FBF3E7"
            android:pathData="M33,35 H75 a8,8 0 0 1 8,8 V67 a8,8 0 0 1 -8,8 H33 a8,8 0 0 1 -8,-8 V43 a8,8 0 0 1 8,-8 Z" />

        <path
            android:fillColor="#DCC7A3"
            android:pathData="M34.5,47 H73.5 a2.5,2.5 0 0 1 2.5,2.5 V49.5 a2.5,2.5 0 0 1 -2.5,2.5 H34.5 a2.5,2.5 0 0 1 -2.5,-2.5 V49.5 a2.5,2.5 0 0 1 2.5,-2.5 Z" />
    </group>
</vector>
