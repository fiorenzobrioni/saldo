    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.84"
        android:scaleY="0.84"
        android:translateY="-3">

        <path
            android:fillColor="#FBBC04"
            android:pathData="M34,30 H62 A4,4 0 0 1 66,34 V52 A4,4 0 0 1 62,56 H34 A4,4 0 0 1 30,52 V34 A4,4 0 0 1 34,30 Z" />

