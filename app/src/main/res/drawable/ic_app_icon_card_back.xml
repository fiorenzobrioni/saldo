<?xml version="1.0" encoding="utf-8"?>
<!--
    Welcome-animation layer: the yellow card (behind-left) only, on the same
    108 canvas and group transform as ic_launcher_foreground, so stacking the
    three ic_app_icon_* layers reproduces the launcher artwork exactly. This
    layer drops in first during the welcome reveal.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.84"
        android:scaleY="0.84"
        android:translateY="-3">

        <path android:pathData="M34,30 H62 A4,4 0 0 1 66,34 V52 A4,4 0 0 1 62,56 H34 A4,4 0 0 1 30,52 V34 A4,4 0 0 1 34,30 Z">
            <aapt:attr name="android:fillColor">
                <gradient android:type="linear"
                    android:startX="30" android:startY="30"
                    android:endX="66" android:endY="56">
                    <item android:offset="0" android:color="#FFFFE07A" />
                    <item android:offset="1" android:color="#FFFBBC04" />
                </gradient>
            </aapt:attr>
        </path>
    </group>
</vector>
