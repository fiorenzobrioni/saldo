<?xml version="1.0" encoding="utf-8"?>
<!--
    Welcome-animation layer: the wallet body + pocket band with thumb-notch,
    drawn in front of the two card layers on the same 108 canvas and group
    transform as ic_launcher_foreground. Being opaque, it hides the lower part
    of the cards as they slot in, producing the "cards tucked into the wallet"
    reveal. Static; only the card layers move.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.84"
        android:scaleY="0.84"
        android:translateY="-3">

        <path android:pathData="M34,48 H74 A10,10 0 0 1 84,58 V74 A10,10 0 0 1 74,84 H34 A10,10 0 0 1 24,74 V58 A10,10 0 0 1 34,48 Z">
            <aapt:attr name="android:fillColor">
                <gradient android:type="linear"
                    android:startX="24" android:startY="48"
                    android:endX="84" android:endY="84">
                    <item android:offset="0" android:color="#FF83B5F8" />
                    <item android:offset="1" android:color="#FF1A73E8" />
                </gradient>
            </aapt:attr>
        </path>

        <path android:pathData="M24,64 H45 A9,9 0 0 0 63,64 H84 V74 A10,10 0 0 1 74,84 H34 A10,10 0 0 1 24,74 Z">
            <aapt:attr name="android:fillColor">
                <gradient android:type="linear"
                    android:startX="24" android:startY="64"
                    android:endX="84" android:endY="84">
                    <item android:offset="0" android:color="#FF3E8CE6" />
                    <item android:offset="1" android:color="#FF1557B0" />
                </gradient>
            </aapt:attr>
        </path>
    </group>
</vector>
