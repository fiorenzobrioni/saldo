<?xml version="1.0" encoding="utf-8"?>
<!--
    The card behind the static picker previews: the default card, the blue
    with the launcher's own corner, so the picker shows the widget as it will
    be placed (ADR 52).
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/widget_preview_card" />
    <corners android:radius="@android:dimen/system_app_widget_background_radius" />
</shape>
