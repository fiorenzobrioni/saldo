<?xml version="1.0" encoding="utf-8"?>
<!--
    The card behind the static picker previews: the default card, Chiaro's blue
    with its 24dp corner, the one Chiaro's and Passo's previews bake too, so the
    family's widgets look like one family in the picker (ADR 52).
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/widget_preview_card" />
    <corners android:radius="24dp" />
</shape>
