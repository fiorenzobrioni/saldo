    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:pivotX="54"
        android:pivotY="54"
        android:scaleX="0.84"
        android:scaleY="0.84"
        android:translateY="-3">

        <path android:pathData="M48,37 H74 A4,4 0 0 1 78,41 V56 A4,4 0 0 1 74,60 H48 A4,4 0 0 1 44,56 V41 A4,4 0 0 1 48,37 Z">
            <aapt:attr name="android:fillColor">
