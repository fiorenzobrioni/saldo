<?xml version="1.0" encoding="utf-8"?>
<!--
    The widget card (ADR 52). The 24dp corner is the card's own rather than the
    system's widget radius, so the card has the same shape on every launcher.

    The fill baked in here is the default card (the blue), and it is
    load-bearing rather than decoration: this drawable is what the host inflates
    for initialLayout, before the first bind ever lands, so without it a freshly
    dropped widget flashes as a white box. At bind time it is re-tinted with the
    resolved day/night pair and given the widget's opacity (see WidgetRenderer).

    The solid is also what makes that tint work at all: GradientDrawable
    substitutes an opaque fill of its own whenever a colour filter is set on a
    shape that declares no solid colour.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/widget_preview_card" />
    <corners android:radius="24dp" />
</shape>
