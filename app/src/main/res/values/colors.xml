<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The badge's ground (ADR 53): Chiaro's and Passo's warm white, so the three icons
         share one ground on a home screen. The foreground carries the rest. -->
    <color name="ic_launcher_background">#F7F4EE</color>

    <!-- The notifications' accent (ADR 52 and 53, after Chiaro's of 23 set 2026): the
         small icon's disc and the app name in the header. The dark end of the icon's sea
         green (the income half): the one colour a user has already seen the app wear
         before opening it. -->
    <color name="notification_accent">#12807D</color>

    <!-- Launcher shortcut icon backgrounds, drawn from the brand palette so the
         adaptive icons stay on-brand and legible under any launcher mask. -->
    <color name="shortcut_expense_background">#BA1A1A</color>
    <color name="shortcut_income_background">#3E6837</color>
    <color name="shortcut_transfer_background">#00696D</color>

    <!--
        The widget card and the static picker previews (ADR 52), and the one
        place their hexes live outside WidgetCardColor.kt: a previewLayout has
        no composition and no theme to read from (the launcher inflates it in a
        restricted context and never runs a line of our code), so the values are
        baked, and baked here rather than across the layouts.

        The card is the family's default one: widgetCardContainer(BLUE), flat,
        the value Chiaro's and Passo's previews bake too, so the three apps'
        widgets look like one family in the picker. It is also the fill the
        placed widget is inflated with before its first bind (widget_bg.xml).
        No values-night variant: a card colour is the same in both themes, and
        so are the inks it carries. WidgetPreviewColorsTest checks the card
        against the Kotlin table.

        The inks are Chiaro's white pair over a card colour (WidgetInk.OVER_COLOR):
        white, and white at 75% for the quiet one. The selected half of the type
        selector is a white pill with the card's own blue as its ink.
    -->
    <color name="widget_preview_card">#FF0F3B6B</color>
    <color name="widget_preview_ink">#FFFFFFFF</color>
    <color name="widget_preview_ink_muted">#BFFFFFFF</color>
    <color name="widget_preview_pill">#FFFFFFFF</color>
    <color name="widget_preview_pill_ink">#FF0F3B6B</color>

    <!-- The bar preview's two accents, as the placed bar draws them on a card
         colour: the dark theme's error red and income green, the set made to
         read on a dark ground. -->
    <color name="widget_preview_expense">#FFB4AB</color>
    <color name="widget_preview_income">#A4D397</color>

    <!--
        What a placed widget's tinted shapes are baked with, seen only in the raw
        initialLayout the host inflates before the first bind lands (see
        widget_tile_bg_wide.xml for why the value is cosmetic): white at a wash's
        strength over the blue card, flattened, so that moment reads as a card
        filling in. Opaque on purpose: SRC_ATOP multiplies the tint by the
        shape's own alpha, so a translucent value here would thin every tinted
        shape on the placed widget too.
    -->
    <color name="widget_placeholder">#FF355A83</color>

    <!--
        The grid preview's category accents: the first seven colours of the
        default seed (DefaultCategories.kt), in seed order, next to the glyphs of
        the same seven categories, lifted 40% towards white as the placed widget
        lifts them on a card colour (WidgetPalette.categoryInk): the seed's
        mid-tones would sink into the dark card.

        Still only resources, so the preview stays correct by construction and
        costs nothing to keep so (ADR 37): nothing here is read from the database
        or rasterized at runtime.
    -->
    <color name="widget_preview_cat_home">#9DA6D9</color>
    <color name="widget_preview_cat_rent">#B29ADA</color>
    <color name="widget_preview_cat_groceries">#A3D6A6</color>
    <color name="widget_preview_cat_dining">#F59896</color>
    <color name="widget_preview_cat_transport">#8EC9F9</color>
    <color name="widget_preview_cat_fuel">#7DCAC2</color>
    <color name="widget_preview_cat_health">#F48CAF</color>
</resources>
