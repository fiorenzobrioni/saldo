<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="ic_launcher_background">#FFFFFF</color>

    <!-- Launcher shortcut icon backgrounds, drawn from the brand palette so the
         adaptive icons stay on-brand and legible under any launcher mask. -->
    <color name="shortcut_expense_background">#BA1A1A</color>
    <color name="shortcut_income_background">#3E6837</color>
    <color name="shortcut_transfer_background">#00696D</color>

    <!--
        Ink and surface of the static widget previews shown in the launcher's
        widget picker (res/layout/quick_*_widget_preview.xml).

        System dynamic-palette resources rather than ?android:attr/textColorPrimary,
        because a previewLayout is not inflated with our theme: AppWidgetHostView
        builds a plain application context (createApplicationContext with
        CONTEXT_RESTRICTED), which has no theme resource, so the framework falls
        back to Theme.DeviceDefault.Light for anything read with ?android:attr -
        near-black ink, invisible on a dark picker sheet. Resources *are*
        resolved against the launcher's configuration, so a values-night variant
        is what actually follows the launcher's light/dark mode.

        The tones mirror what the placed widget draws under Material You: the
        surface is the widgetBackground token (secondaryContainer, tone 90+5 in
        light and 30-10 in dark, hence accent2 at tones 95/20), the inks are
        onSurface (neutral1 at 10/90) and onSurfaceVariant (neutral2 at 30/80).
    -->
    <color name="widget_preview_surface">@android:color/system_accent2_50</color>
    <color name="widget_preview_ink">@android:color/system_neutral1_900</color>
    <color name="widget_preview_ink_muted">@android:color/system_neutral2_700</color>

    <!-- The bar preview's two accents, mirroring the real buttons (error red
         and the brand's income green). Fixed brand values rather than system
         tokens: the dynamic palette carries no red, and the income green is a
         brand choice the system palette cannot express. -->
    <color name="widget_preview_expense">#BA1A1A</color>
    <color name="widget_preview_income">#3E6837</color>

    <!--
        What a placed widget's tinted shapes are baked with, seen only in the raw
        initialLayout the host inflates before the first bind lands (see
        widget_tile_bg_wide.xml for why the value is cosmetic). A muted step off
        the container colour, so that moment reads as a widget filling in.
    -->
    <color name="widget_placeholder">#DCD2EA</color>

    <color name="widget_preview_pill">@android:color/system_accent1_600</color>
    <color name="widget_preview_pill_ink">@android:color/system_accent1_50</color>

    <!--
        The grid preview's category accents: the first seven colours of the
        default seed (DefaultCategories.kt), in seed order, next to the glyphs of
        the same seven categories.

        Fixed hex and no values-night variant on purpose, because that is exactly
        how the placed widget draws them: a category's colour is the one its user
        picked, so the ink is the same on both branches and only the wash behind
        it differs - which the layout gets from android:alpha over the surface,
        not from a second set of colours.

        Still only resources, so the preview stays correct by construction and
        costs nothing to keep so (ADR 37): nothing here is read from the database
        or rasterized at runtime. It is what a fresh install actually shows,
        which is the honest thing to advertise in the picker.
    -->
    <color name="widget_preview_cat_home">#5C6BC0</color>
    <color name="widget_preview_cat_rent">#7E57C2</color>
    <color name="widget_preview_cat_groceries">#66BB6A</color>
    <color name="widget_preview_cat_dining">#EF5350</color>
    <color name="widget_preview_cat_transport">#42A5F5</color>
    <color name="widget_preview_cat_fuel">#26A69A</color>
    <color name="widget_preview_cat_health">#EC407A</color>
</resources>
