<?xml version="1.0" encoding="utf-8"?>
<!--
    Static preview for the widget picker: the fallback for devices below API 35
    and for the window where the generated preview (published by WidgetPreviews)
    has been dropped by an update or a reboot and not yet republished.

    Colors come from res/values(-night)/colors.xml, not from ?android:attr:
    a previewLayout is inflated with a plain application context, whose theme
    falls back to Theme.DeviceDefault.Light, so theme attributes gave near-black
    ink on a dark picker sheet. Resource qualifiers are resolved against the
    launcher's configuration and do follow its light/dark mode.

    The mark is the launcher foreground vector, not the adaptive shortcut icon:
    AppWidgetHostView renders AdaptiveIconDrawable unreliably in a previewLayout.
    The foreground keeps its artwork inside the adaptive safe zone, hence the
    56dp box for a ~40dp visible mark.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_preview_background"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="12dp">

    <ImageView
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_launcher_foreground" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxLines="1"
        android:text="@string/widget_quick_add_label"
        android:textColor="@color/widget_preview_ink"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:maxLines="2"
        android:text="@string/widget_quick_add_description"
        android:textColor="@color/widget_preview_ink_muted"
        android:textSize="11sp" />
</LinearLayout>
