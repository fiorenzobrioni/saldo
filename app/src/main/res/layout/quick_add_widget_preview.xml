<?xml version="1.0" encoding="utf-8"?>
<!--
    Static preview for the widget picker: the real widget cannot be composed
    there (no data, no GlanceId), so this stands in for it. Colors come from
    theme attributes so the picker preview follows the launcher's light/dark
    mode instead of being hardcoded.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="12dp">

    <ImageView
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:contentDescription="@null"
        android:src="@drawable/ic_shortcut_expense" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxLines="1"
        android:text="@string/widget_quick_add_label"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center"
        android:maxLines="2"
        android:text="@string/widget_quick_add_description"
        android:textColor="?android:attr/textColorSecondary"
        android:textSize="11sp" />
</LinearLayout>
