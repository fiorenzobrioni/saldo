<?xml version="1.0" encoding="utf-8"?>
<!--
    The single-row layout: expense and income share the width and grow with it,
    so the same widget works at two launcher columns and at five. It is the
    whole of the bar widget and the squashed end of the grid one.

    Each button is an ImageView carrying the tinted shape with its content on
    top, not a container with a background: setColorFilter is the only tint a
    RemoteViews can apply and it only reaches an ImageView. The gaps are empty
    FrameLayouts because RemoteViews does not accept Space.

    The app-shortcut square is the one view whose width is set at bind time
    (setViewLayoutWidth): it follows the height the render was asked for, so
    the button stays square on a launcher whose row runs taller than ours.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:padding="14dp">

        <FrameLayout
            android:id="@+id/widget_action_expense"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/widget_action_expense_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/widget_action_bg" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Not decoration: the project requires expense and income to
                     be told apart by more than colour. -->
                <ImageView
                    android:id="@+id/widget_action_expense_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/widget_action_expense_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:maxLines="1"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/widget_action_gap"
            android:layout_width="8dp"
            android:layout_height="match_parent" />

        <FrameLayout
            android:id="@+id/widget_action_income"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1">

            <ImageView
                android:id="@+id/widget_action_income_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/widget_action_bg" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/widget_action_income_icon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:importantForAccessibility="no" />

                <TextView
                    android:id="@+id/widget_action_income_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:maxLines="1"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </FrameLayout>

        <FrameLayout
            android:id="@+id/widget_shortcut_gap"
            android:layout_width="8dp"
            android:layout_height="match_parent" />

        <!--
            The way into the app from the single row, which has no room for the
            "open Saldo" tile the taller layouts carry. A quiet neutral wash
            rather than a bare mark: on a widget a naked icon just hovers, and
            a third accent would compete with the pair that matters.
        -->
        <FrameLayout
            android:id="@+id/widget_action_shortcut"
            android:layout_width="56dp"
            android:layout_height="match_parent">

            <ImageView
                android:id="@+id/widget_action_shortcut_bg"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:scaleType="fitXY"
                android:src="@drawable/widget_action_bg" />

            <ImageView
                android:id="@+id/widget_action_shortcut_icon"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
