<?xml version="1.0" encoding="utf-8"?>
<!-- One budget in notification_budget_expanded.xml: its name and figures on one
     line, the bar under them. Added as a nested RemoteViews per budget, so the ids
     below belong to their own row. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/notif_budget_name"
            style="@style/TextAppearance.Compat.Notification"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1" />

        <TextView
            android:id="@+id/notif_budget_value"
            style="@style/TextAppearance.Compat.Notification"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:maxLines="1" />
    </LinearLayout>

    <ProgressBar
        android:id="@+id/notif_budget_bar"
        style="@android:style/Widget.Material.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="6dp"
        android:layout_marginTop="4dp"
        android:max="100" />
</LinearLayout>
