<?xml version="1.0" encoding="utf-8"?>
<!--
    No account or no category of this type yet: the whole widget is a door into
    the app, not just the line of text - a target the size of the widget for the
    one moment the user has nothing else to tap.

    The mark is hidden by the renderer at the shortest sizes, where it would
    crowd out the words that explain the tap.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingHorizontal="12dp"
        android:paddingVertical="8dp">

        <ImageView
            android:id="@+id/widget_setup_mark"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginBottom="6dp"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/widget_setup_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:maxLines="3"
            android:text="@string/widget_quick_add_setup"
            android:textSize="13sp" />
    </LinearLayout>
</FrameLayout>
