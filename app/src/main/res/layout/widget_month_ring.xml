<?xml version="1.0" encoding="utf-8"?>
<!--
    «The month» in a row or a wide panel (ADR 54): the ring, the share of the
    budget spent inside it, and up to three lines beside it. The ring's box is
    the one view sized at bind time (setViewLayoutWidth/Height): its side
    follows the breakpoint, so a row of any height gets a ring that fills it.
    The renderer also sets the padding (a row's 10 dp, a panel's 14) and hides
    the words where a row has no room for them.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:id="@+id/widget_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no"
        android:scaleType="fitXY"
        android:src="@drawable/widget_bg" />

    <LinearLayout
        android:id="@+id/widget_month_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="14dp">

        <FrameLayout
            android:id="@+id/widget_ring_box"
            android:layout_width="56dp"
            android:layout_height="56dp">

            <ProgressBar
                android:id="@+id/widget_ring"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:importantForAccessibility="no"
                android:indeterminate="false"
                android:max="1000"
                android:progressDrawable="@drawable/widget_month_ring" />

            <TextView
                android:id="@+id/widget_ring_percent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:fontFamily="sans-serif-medium"
                android:includeFontPadding="false"
                android:maxLines="1"
                android:textSize="@dimen/widget_type_label" />
        </FrameLayout>

        <LinearLayout
            android:id="@+id/widget_ring_text"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/widget_ring_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:maxLines="2"
                android:textSize="@dimen/widget_type_body" />

            <TextView
                android:id="@+id/widget_ring_line1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:textSize="@dimen/widget_type_label" />

            <TextView
                android:id="@+id/widget_ring_line2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textSize="@dimen/widget_type_label" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
