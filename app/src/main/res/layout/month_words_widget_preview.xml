<?xml version="1.0" encoding="utf-8"?>
<!--
    The widget picker's preview of «In words» (ADR 54). Static resources only
    (ADR 37b): the default card, the panel form with sample words from
    widget_preview_* strings. Nothing is read from the database.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_preview_background"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="2dp"
        android:maxLines="1"
        android:text="@string/widget_preview_words_month"
        android:textColor="@color/widget_preview_ink_muted"
        android:textSize="@dimen/widget_type_label" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:maxLines="2"
        android:text="@string/widget_preview_words_sentence"
        android:textColor="@color/widget_preview_ink"
        android:textSize="@dimen/widget_type_body" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:maxLines="1"
        android:text="@string/widget_preview_ring_spent"
        android:textColor="@color/widget_preview_ink_muted"
        android:textSize="@dimen/widget_type_label" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxLines="1"
        android:text="@string/widget_preview_words_next"
        android:textColor="@color/widget_preview_ink_muted"
        android:textSize="@dimen/widget_type_label" />
</LinearLayout>
