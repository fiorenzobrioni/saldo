<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Informative/confirmation notifications for generated recurring movements. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Reading ECB exchange rates, the only network traffic outside optional
         backup/export (ADR 40): inbound data, no account, no user data sent. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Biometric unlock of the optional app lock (normal permission, no prompt). -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <application
        android:name=".SaldoApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Saldo">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Static launcher shortcuts: long-press the icon to add a movement. -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!--
            Home screen quick-add widget. The receiver is exported because the
            launcher has to reach it; the two activities below are not, since
            only the widget's own in-app actions start them.
        -->
        <receiver
            android:name=".feature.widget.SaldoQuickAddWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_quick_add_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/quick_add_widget_info" />
        </receiver>

        <!-- The single-row bar as its own provider: its own picker card, its
             own preview, and a shape pinned by maxResizeHeight. -->
        <receiver
            android:name=".feature.widget.SaldoQuickBarWidgetReceiver"
            android:exported="true"
            android:label="@string/widget_quick_bar_label">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/quick_bar_widget_info" />
        </receiver>

        <!--
            The amount step: a translucent sheet over the launcher, not the app.

            The empty taskAffinity is what makes that true. Without it the sheet
            inherits the app's affinity, so when the main task is still alive in
            the background - closed with a swipe up or from recents rather than
            with Back - starting the sheet brings that whole task forward and the
            sheet lands on top of the Dashboard. Its own task keeps the launcher
            where it was.
        -->
        <activity
            android:name=".feature.widget.QuickEntryActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTop"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.Saldo.Transparent" />

        <activity
            android:name=".feature.widget.QuickAddWidgetConfigActivity"
            android:exported="false">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!--
            "Add expense" Quick Settings tile (ADR 41): a second static entry
            point to the quick entry sheet above. Exported because the system
            binds it; the BIND permission keeps everyone else out. The tile
            never shows data, so there is nothing to refresh (ADR 37).
        -->
        <service
            android:name=".feature.widget.QuickAddTileService"
            android:exported="true"
            android:icon="@drawable/ic_tile_quick_add"
            android:label="@string/tile_quick_add_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Shares CSV exports from the cache directory via the system Share Sheet. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- On-demand WorkManager init with the Hilt factory: remove the default initializer. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>

</manifest>
